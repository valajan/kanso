GITHUB_APP_ID=
GITHUB_WEBHOOK_SECRET=
GITHUB_PRIVATE_KEY_PATH=./kanso.pem
PORT=3000

# Max concurrent Lighthouse audits (one headless Chrome each, ~300-400 MB).
# Default 3, sized for a 1 GB container.
LIGHTHOUSE_CONCURRENCY=3

# ── Capacity ────────────────────────────────────────────────────────────────
# Audits run in a bounded background queue so neither trigger holds a request
# open for the minutes an audit takes. Each job runs up to 4 Lighthouse audits,
# which then queue behind LIGHTHOUSE_CONCURRENCY above.
# KANSO_JOB_CONCURRENCY=2          # audits running at once
# KANSO_MAX_QUEUED=20              # audits waiting before the API answers 429
# KANSO_RATE_LIMIT_PER_MINUTE=10   # /v1/audit requests per repository

# ── Security ────────────────────────────────────────────────────────────────
# POST /v1/audit takes a preview URL from its caller, so that URL is vetted
# before headless Chrome ever loads it: private, loopback, link-local and
# reserved addresses are refused, which is what keeps the cloud metadata service
# (169.254.169.254) out of reach.
#
# Set this in any deployment sitting on a network with internal services. It
# pins the hosts Kanso will ever fetch, and it is the only check that also holds
# against DNS rebinding — the guard resolves the name, but Chrome resolves it
# again when it loads the page.
# KANSO_ALLOWED_PREVIEW_HOSTS=*.netlify.app,*.vercel.app,acme.com

# Self-hosted GitHub (GitHub Enterprise Server). Operator-level on purpose: a
# caller must never be able to steer Kanso's outbound API calls.
# KANSO_GITHUB_API_URL=https://github.acme.com/api/v3

# ── AI analysis (src/ai-analysis) ───────────────────────────────────────────
# The provider is not hardcoded: any OpenAI-compatible API works. The key and
# the endpoint keep their ecosystem-standard names (every compatible provider
# documents these two, and the SDK reads them natively); Kanso's own knobs are
# prefixed KANSO_AI_.
#
# API key used to generate a remediation section in the GitHub comment when a
# Lighthouse metric is in the red AND the regression vs main exceeds 10%.
# Optional — if unset, the AI analysis is silently skipped without breaking
# the main pipeline. Everything below only applies when it is set.
OPENAI_API_KEY=

# Endpoint, for a provider other than OpenAI (OpenRouter, Groq, Azure, a local
# Ollama). Leave unset for the official API (https://api.openai.com/v1).
# OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Model, limits and timeout for the analysis call. Shown below with their
# defaults — uncomment to override.
# KANSO_AI_MODEL=gpt-5.5
# KANSO_AI_MAX_TOKENS=4000
# KANSO_AI_TIMEOUT_MS=30000
# KANSO_AI_MAX_RETRIES=2
