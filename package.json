{
  "name": "@valajan/kanso",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "description": "Kanso \u2014 performance, accessibility, SEO and best-practices audits of a web page, from the terminal, your coding agent, or your CI",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/valajan/kanso.git"
  },
  "bin": {
    "kanso": "bin/kanso.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "kanso": "node bin/kanso.js",
    "test": "node --test \"src/**/__tests__/*.test.js\"",
    "test:probes": "node --test --test-reporter=spec test/probes/probes.test.mjs",
    "test:acceptance": "node --test --test-concurrency=1 --test-reporter=spec test/acceptance/kanso-frontend.test.mjs"
  },
  "engines": {
    "node": ">=22.19"
  },
  "dependencies": {
    "axe-core": "4.13.0",
    "chrome-launcher": "^1.2.1",
    "js-yaml": "^4.1.1",
    "lighthouse": "^13.5.0",
    "puppeteer-core": "^24.42.0"
  }
}
